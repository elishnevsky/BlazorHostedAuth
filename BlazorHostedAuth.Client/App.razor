@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <Authorizing>
                    <p>Authenticating...</p>
                </Authorizing>
                <NotAuthorized>
                    <p>You are not authorized.</p>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <p>Page not found.</p>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Http.GetAsync("/api/auth/login");

        // The first time the app loads, the `/api/auth/me` endpoint will return 401,
        // but after the login endpoint is hit, it will return the user info.
        // So we need to notify the authentication state provider to re-query the user info.
        var provider = (CookieAuthenticationStateProvider)AuthStateProvider;
        provider.NotifyAuthenticationStateChanged();
    }
}