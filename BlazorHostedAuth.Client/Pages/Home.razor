@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<AuthorizeView>
    <Authorized>
        <p>Welcome to your new app, @context.User.Identity!.Name</p>
    </Authorized>
    <NotAuthorized>
        <p>PYou are not authorized.</p>
    </NotAuthorized>
</AuthorizeView>

